{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:css": "node scripts/check-css.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:webdist": "node ../scripts/check-webdist.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:paths": "node scripts/check-api-paths.mjs",
    "check:openapi-types": "node scripts/check-openapi-types.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "gen:openapi": "openapi-typescript ../api/openapi.yaml -o src/lib/api-schema.d.ts",
    "gen:permissions": "node scripts/gen-permissions.mjs",
    "check": "npm run check:css && npm run check:tokens && npm run check:i18n && npm run check:paths && npm run check:openapi-types && npm run check:permissions && npm run check:webdist && npm run check:bundle"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.11",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.24.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.19",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.1.1"
  }
}

{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:css": "node scripts/check-css.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:webdist": "node ../scripts/check-webdist.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:paths": "node scripts/check-api-paths.mjs",
    "check:openapi-types": "node scripts/check-openapi-types.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "gen:openapi": "openapi-typescript ../api/openapi.yaml -o src/lib/api-schema.d.ts",
    "gen:permissions": "node scripts/gen-permissions.mjs",
    "check": "npm run check:css && npm run check:tokens && npm run check:i18n && npm run check:paths && npm run check:openapi-types && npm run check:permissions && npm run check:webdist && npm run check:bundle"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

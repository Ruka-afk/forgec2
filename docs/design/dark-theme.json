{
  "version": "1.0",
  "name": "ForgeC2 Dark Theme",
  "theme": "dark",
  "selector": ".dark",
  "colors": {
    "background": "#0f172a",
    "card-bg": "#1e293b",
    "card-bg-secondary": "#1e293b",
    "sidebar-bg": "#0f172a",
    "border": "#334155",
    "border-hover": "#475569",
    "text-primary": "#f1f5f9",
    "text-secondary": "#94a3b8",
    "text-tertiary": "#64748b",
    "text-link": "#818cf8",
    "success": "#34d399",
    "success-bg": "#064e3b",
    "success-text": "#6ee7b7",
    "warning": "#fbbf24",
    "warning-bg": "#78350f",
    "warning-text": "#fcd34d",
    "danger": "#f87171",
    "danger-bg": "#7f1d1d",
    "danger-text": "#fca5a5",
    "info": "#60a5fa",
    "info-bg": "#1e3a5f",
    "info-text": "#93c5fd",
    "nav-active-bg": "#4338ca",
    "nav-active-text": "#e0e7ff",
    "nav-active-border": "#818cf8",
    "scrollbar-thumb": "#475569"
  },
  "shadows": {
    "shadow-sm": "0 1px 2px 0 rgb(0 0 0 / 0.2)",
    "shadow-md": "0 4px 6px -1px rgb(0 0 0 / 0.3), 0 2px 4px -2px rgb(0 0 0 / 0.2)",
    "shadow-lg": "0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.2)",
    "shadow-card": "0 1px 2px 0 rgb(0 0 0 / 0.2)"
  }
}

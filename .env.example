# ForgeC2 Docker Environment Variables
# Copy this file to .env and fill in your values

# JWT secret for session authentication (auto-generated if empty)
FORGEC2_JWT_SECRET=

# AI provider API key (DeepSeek/OpenAI/Claude)
FORGEC2_AI_API_KEY=

# Server bind host and port
FORGEC2_HOST=0.0.0.0
FORGEC2_PORT=8000

# Database path (inside container)
FORGEC2_DB_PATH=/data/db/forgec2.db

# Timezone
TZ=UTC

# PostgreSQL (uncomment if using postgres service)
# DB_PASSWORD=your_secure_password

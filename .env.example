# ForgeC2 Docker Environment Variables
# Copy this file to .env and fill in your values
# Production: prefer env injection over committing config.yaml
# (config.yaml is gitignored; see config.example.yaml for secure defaults)

# JWT secret for session authentication (auto-generated if empty)
FORGEC2_JWT_SECRET=

# 32-byte hex keys (64 hex chars each). Leave empty to auto-generate on first run.
FORGEC2_LOOT_KEY=
FORGEC2_EXTC2_KEY=
FORGEC2_BACKUP_KEY=
FORGEC2_TOTP_KEY=
FORGEC2_CSRF_KEY=

# Beacon / implant shared key (must be "ecdh:" to enable ECDH+AES-256-GCM)
# FORGEC2_BEACON_KEY=ecdh:

# AI provider API key (DeepSeek/OpenAI/Claude)
FORGEC2_AI_API_KEY=

# Slack bot token for ExtC2 notifications (optional)
# FORGEC2_SLACK_BOT_TOKEN=

# Server bind host and port
FORGEC2_HOST=127.0.0.1
FORGEC2_PORT=8000

# Database path (inside container)
FORGEC2_DB_PATH=/data/db/forgec2.db

# Timezone
TZ=UTC

# PostgreSQL (uncomment if using postgres service)
# DB_PASSWORD=your_secure_password
